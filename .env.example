# =============================================================================
# TravelMate AI - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' for local development overrides.
# In production, set these variables in your cloud hosting provider dashboard.
# DO NOT commit the actual '.env' file containing real secrets to version control.
# =============================================================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travelmate_ai
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Alternatively, provide a full JDBC URL (useful for cloud providers like Render / AWS / Railway):
# SPRING_DATASOURCE_URL=jdbc:mysql://your-host:3306/travelmate_ai?useSSL=true

# JWT Authentication Secret (Required: must be at least 32 characters / 256 bits)
JWT_SECRET=your_secure_256_bit_jwt_secret_key_minimum_32_characters
JWT_EXPIRATION_MS=86400000

# Initial Administrator Accounts (Optional: set to seed initial admin accounts)
ADMIN1_EMAIL=admin1@example.com
ADMIN1_PASSWORD=YourStrongAdminPassword1!
ADMIN1_NAME=Administrator One

ADMIN2_EMAIL=admin2@example.com
ADMIN2_PASSWORD=YourStrongAdminPassword2!
ADMIN2_NAME=Administrator Two

# Microservices & External APIs
ML_SERVICE_URL=http://localhost:8000
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org

# Optional External API Keys
GOOGLE_PLACES_API_KEY=

# Server Ports & Profiles & CORS
PORT=8080
SPRING_PROFILES_ACTIVE=local
# Allowed CORS Origins (comma-separated, e.g. http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
