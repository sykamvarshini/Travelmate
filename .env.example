# TravelMate AI - Environment Configuration Example
# Copy to .env for local overrides

# Database Configuration (MySQL 9.6)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travelmate_ai
DB_USERNAME=root
DB_PASSWORD=Ammulu@3004

# JWT Authentication Secret (HMAC SHA-256 base64 string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Python ML Microservice URL
ML_SERVICE_URL=http://localhost:8000

# Live Weather API (Open-Meteo)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# OpenStreetMap Geocoding API
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Open Source Routing Machine (OSRM)
OSRM_BASE_URL=https://router.project-osrm.org

# Google Gemini AI Assistant API Key (Optional: Graceful deterministic fallback used when absent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend Development Port
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
